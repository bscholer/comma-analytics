# Copy to .env and fill in, or let ./setup.py write it.

# --- required ---------------------------------------------------------------
# comma account token: log in at https://jwt.comma.ai and copy the token (valid ~90 days)
COMMA_TOKEN=
# your device's dongle id (comma connect → device settings, or ./setup.py lists them)
DONGLE_ID=
# IANA time zone the dashboard shows times in, e.g. America/New_York or Europe/Berlin (setup suggests this machine's)
TZ_NAME=UTC
# imperial (mi, mph) or metric (km, km/h): only changes the dashboard; re-run setup or edit, then docker compose up -d
UNITS=imperial
GRAFANA_PORT=3000
# generated secrets: any long random strings (INFLUX_* only take effect on the very first start)
GRAFANA_PASSWORD=
INFLUX_PASSWORD=
INFLUX_TOKEN=
INFLUX_ORG=comma
INFLUX_BUCKET=comma
# host user that owns ./archive (id -u / id -g)
APP_UID=1000
APP_GID=1000

# --- optional ---------------------------------------------------------------
# label for every drive when Home Assistant isn't set up
DRIVER_NAME=driver
# Home Assistant: a sensor whose state is the active driver's name, e.g. sensor.<vehicle>_active_driver from the
# Rivian (Unofficial) integration (HACS: github.com/bretterer/home-assistant-rivian)
HA_URL=
HA_TOKEN=
HA_DRIVER_ENTITY=
# direct copy from the comma on your LAN after parking (adds rlogs: Rivian braking/EPS data). Needs secrets/comma_ssh_key.
DEVICE_IP=
# the dashboard shows how many commits behind its branch on GitHub the newest drive was, using the repo the device's
# openpilot was installed from. Set owner/repo here only to compare against a different one
GITHUB_REPO=
# view without logging in
GRAFANA_ANONYMOUS=false
# keep the raw logs somewhere other than ./archive (e.g. an existing archive from an older install)
ARCHIVE_PATH=

# --- advanced (defaults shown) -------------------------------------------------
# how far back the first cloud pull looks, in days, and how often the daemon pulls (seconds)
# FIRST_DAYS=30
# skip the per-minute road-camera snapshots for drives before this date (YYYY-MM-DD), e.g. to keep a big import small
# THUMBNAILS_SINCE=
# CLOUD_INTERVAL=3600
# DEVICE_INTERVAL=60
# the bundled Grafana's image tag (13.2 or newer)
# GRAFANA_VERSION=13.2.1
# a Grafana of your own: a service account token (Editor) instead of the admin password; see "Using your own Grafana"
# in the README for GRAFANA_URL / GRAFANA_INFLUX_URL
# GRAFANA_TOKEN=
# use this InfluxDB read token for Grafana's data source instead of making a new one on every start
# INFLUX_READ_TOKEN=
# tokens / SSH key from elsewhere: see docker-compose.override.example.yml
# AUTH_FILE=
# SSH_KEY=/secrets/comma_ssh_key
